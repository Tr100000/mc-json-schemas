{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$ref": "#/definitions/def",
  "definitions": {
    "def": {
      "type": "object",
      "properties": {
        "asset_id": {
          "$ref": "#/definitions/identifier"
        },
        "translation_key": {
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "translation_key"
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "([_\\-a-z0-9.]+:)?[_\\-a-z0-9/.]+"
    }
  }
}