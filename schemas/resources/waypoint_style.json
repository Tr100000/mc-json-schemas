{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$ref": "#/definitions/def",
  "definitions": {
    "def": {
      "type": "object",
      "properties": {
        "near_distance": {
          "$ref": "#/definitions/def_1",
          "default": 128
        },
        "far_distance": {
          "$ref": "#/definitions/def_1",
          "default": 332
        },
        "sprites": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/identifier"
          }
        }
      },
      "required": [
        "sprites"
      ]
    },
    "def_1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000000
    },
    "identifier": {
      "type": "string",
      "pattern": "([_\\-a-z0-9.]+:)?[_\\-a-z0-9/.]+"
    }
  }
}